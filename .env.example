# ==========================================================
# Ek customer = ek Supabase project. Ei 6 ta value bosalei
# website er backend kaj korbe. Onno kono key lagbe na.
# Supabase Dashboard -> Project Settings -> API theke nin.
# ==========================================================

# --- Browser (build time e lage) ---
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-ANON-PUBLISHABLE-KEY"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# --- Server / Cloudflare Worker (runtime e lage) ---
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR-ANON-PUBLISHABLE-KEY"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"
